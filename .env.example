# Firebase Admin — server only. Never expose these as NEXT_PUBLIC_* variables.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Isolate this new Taallamt backend from legacy collections already present in the same Firestore database.
# Leave as taallamt_v2 unless you intentionally migrate to another namespace.
FIRESTORE_COLLECTION_PREFIX=taallamt_v2

# No extra session peppers are required in the current backend.
# Guardian access codes and the teacher PIN use salted scrypt hashes.
# Session cookies contain random 256-bit tokens; only SHA-256 digests are stored in Firestore.

# Optional legacy compatibility only. Leave unset for new installations.
# GUARDIAN_CODE_PEPPER=legacy-only
# TEACHER_ACCESS_PIN_HASH=legacy-managed-pin-hash
