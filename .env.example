# Firebase Admin — server only. Never expose these as NEXT_PUBLIC_* variables.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Isolate this Taallamt backend from legacy collections already present in the same Firestore database.
# Leave as taallamt_v2 unless you intentionally migrate to another namespace.
FIRESTORE_COLLECTION_PREFIX=taallamt_v2

# One server-only authentication pepper for low-entropy teacher/guardian codes and session HMACs.
# Use a cryptographically random value of at least 32 characters. Never expose as NEXT_PUBLIC_*.
TAALLAMT_AUTH_PEPPER=replace-with-a-long-random-secret-at-least-32-characters
