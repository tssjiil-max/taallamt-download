# Firebase Admin — server only. Never expose these as NEXT_PUBLIC_* variables.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Guardian security. Use long random values (at least 24 characters).
# Rotate carefully because rotation invalidates hashes/sessions.
GUARDIAN_CODE_PEPPER=replace-with-a-long-random-secret
GUARDIAN_SESSION_PEPPER=replace-with-a-different-long-random-secret

# Teacher security.
# Generate TEACHER_ACCESS_PIN_HASH locally with: npm run hash:teacher-pin -- 123456
# Store only the generated salt:hash value, never the raw PIN.
TEACHER_ACCESS_PIN_HASH=replace-with-generated-scrypt-hash
TEACHER_SESSION_PEPPER=replace-with-another-long-random-secret
