{
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "0 2 * * 0-4"
    },
    {
      "path": "/api/cron-weekly",
      "schedule": "0 5 * * 6"
    }
  ],
  "rewrites": [
    {
      "source": "/api/lesson-assistant",
      "destination": "/api/learning-automation?action=assistant"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
