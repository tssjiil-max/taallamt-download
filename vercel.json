{
  "crons": [
    {
      "path": "/api/cron-daily",
      "schedule": "0 2 * * 0-4"
    },
    {
      "path": "/api/cron-weekly",
      "schedule": "0 5 * * 6"
    }
  ],
  "functions": {
    "api/learning-automation.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/teacher/student/:id",
      "destination": "/legacy.html"
    },
    {
      "source": "/teacher/students",
      "destination": "/legacy.html"
    },
    {
      "source": "/teacher/library",
      "destination": "/legacy.html"
    },
    {
      "source": "/teacher/settings",
      "destination": "/legacy.html"
    },
    {
      "source": "/teacher/announcements",
      "destination": "/legacy.html"
    },
    {
      "source": "/teacher/tasks",
      "destination": "/legacy.html"
    },
    {
      "source": "/teacher/followup",
      "destination": "/legacy.html"
    },
    {
      "source": "/teacher/messages",
      "destination": "/legacy.html"
    },
    {
      "source": "/teacher/stars",
      "destination": "/legacy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "preview/student-teacher-staging-20261006": true
    }
  },
  "headers": [
    {
      "source": "/manifest-teacher.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest-student.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/pwa-identity.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/pwa/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
